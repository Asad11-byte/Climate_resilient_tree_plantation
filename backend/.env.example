# --- App ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# --- Groq (LLM generation) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- Jina (embeddings + reranker) ---
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# --- Qdrant ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=mandi_tree_knowledge

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Environmental data (Phase 5) ---
# SoilGrids and NASA POWER are public APIs — no key required, but their base
# URLs are configurable in case ISRIC/NASA change endpoints.
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/climatology/point
ENVIRONMENT_CACHE_TOLERANCE_DEGREES=0.05

# Google Earth Engine (SoilGridsGEEProvider, SentinelProvider)
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=./secrets/gee-key.json
# GEE_SERVICE_ACCOUNT_KEY_JSON=  # alternative to the path above